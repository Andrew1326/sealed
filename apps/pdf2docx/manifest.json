{
  "name": "pdf2docx",
  "version": "0.1.0",
  "description": "Rebuild a PDF as an editable DOCX with real paragraphs and tables (pdf2docx + PyMuPDF), fully offline. Not an AI app.",
  "vendor": "sealed (community)",
  "license": "AGPL-3.0",
  "operations": ["convert"],
  "input": "application/pdf",
  "output": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  "output_extension": "docx",
  "requires": {"gpu": "none", "memory": "2g", "timeout_seconds": 300}
}
