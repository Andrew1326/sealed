{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sealed app manifest",
  "type": "object",
  "required": ["name", "version", "operations", "input", "output"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "vendor": {"type": "string"},
    "license": {"type": "string"},
    "operations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "enum": ["translate", "summarize", "extract", "classify", "ocr", "transcribe", "custom"]}
    },
    "input": {"type": "string", "enum": ["text/plain", "application/json", "application/octet-stream"]},
    "output": {"type": "string", "enum": ["text/plain", "application/json"]},
    "requires": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "gpu": {"type": "string", "enum": ["none", "optional", "required"]},
        "memory": {"type": "string", "pattern": "^[0-9]+[mg]$"},
        "cpus": {"type": "number"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "models": {
      "type": "array",
      "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "sha256": {"type": "string"}, "license": {"type": "string"}}}
    }
  }
}
