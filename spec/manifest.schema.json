{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sealed app manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "operations",
    "input",
    "output"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
      }
    },
    "input": {
      "type": "string",
      "description": "MIME type. text/* and application/json are passed as text/JSON; anything else is base64 in the job's input field."
    },
    "output": {
      "type": "string",
      "description": "MIME type. text/* and application/json come back as text/JSON; anything else is base64 in the result's output field."
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+[mg]$"
        },
        "cpus": {
          "type": "number"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        }
      }
    },
    "output_extension": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,8}$",
      "description": "file extension for binary outputs (e.g. pdf)"
    }
  }
}
